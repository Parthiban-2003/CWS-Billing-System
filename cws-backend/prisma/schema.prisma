generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// TENANT
// ─────────────────────────────────────────────
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("trial")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    Product[]
  invoices    Invoice[]
  tables      RestTable[]
  kots        Kot[]
  combos      Combo[]
  ingredients Ingredient[]
  wastages    Wastage[]
  settings    TenantSetting?
}

// ─────────────────────────────────────────────
// TENANT SETTINGS
// ─────────────────────────────────────────────
model TenantSetting {
  id             String  @id @default(uuid())
  tenantId       String  @unique
  companyName    String  @default("CWS Smart Billing")
  logo           String?
  gstin          String?
  address        String?
  phone          String?
  footerMsg      String  @default("Thank you! Visit again")
  taxPct         Decimal @default(0) @db.Decimal(5, 2)
  servicePct     Decimal @default(0) @db.Decimal(5, 2)
  invoicePrefix  String  @default("INV")
  happyStart     String?
  happyEnd       String?
  happyPct       Decimal @default(0) @db.Decimal(5, 2)
  loyaltyEnabled Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// PRODUCTS
// ─────────────────────────────────────────────
model Product {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name     String
  category String?
  barcode  String?
  kind     String  @default("PRODUCT")

  price      Decimal @default(0) @db.Decimal(10, 2)
  stock      Decimal @default(0) @db.Decimal(12, 3)
  lowStockAt Decimal @default(5) @db.Decimal(12, 3)

  isAvailable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants    Variant[]
  modifiers   Modifier[]
  comboItems  ComboItem[]
  recipeItems RecipeItem[]
  wastages    Wastage[]

  @@unique([tenantId, barcode])
  @@index([tenantId, name])
}

model Variant {
  id        String  @id @default(uuid())
  productId String
  name      String
  delta     Decimal @default(0) @db.Decimal(10, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Modifier {
  id        String  @id @default(uuid())
  productId String
  name      String
  delta     Decimal @default(0) @db.Decimal(10, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// CUSTOMERS
// ─────────────────────────────────────────────
model Customer {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  phone      String?
  gstin      String?
  points     Int      @default(0)
  totalSpent Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  invoices Invoice[]

  @@index([tenantId, name])
}

// ─────────────────────────────────────────────
// INVOICES (with loyalty snapshot)
// ─────────────────────────────────────────────
model Invoice {
  id        String  @id @default(uuid())
  tenantId  String
  number    Int
  table     String?
  orderType String
  method    String

  subtotal     Decimal @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  service      Decimal @default(0) @db.Decimal(10, 2)
  roundOff     Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)
  paid         Decimal @default(0) @db.Decimal(10, 2)
  pointsBefore Int     @default(0)
  pointsAfter  Int     @default(0)

  status       String   @default("PAID")
  customerId   String?
  redeemed     Int      @default(0)
  pointsEarned Int      @default(0)
  createdAt    DateTime @default(now())

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  customer Customer?     @relation(fields: [customerId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@index([tenantId, createdAt])
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String
  productId String?

  name        String
  qty         Int
  price       Decimal @db.Decimal(10, 2)
  amount      Decimal @db.Decimal(10, 2)
  variantName String?
  modifiers   String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  amount    Decimal  @db.Decimal(10, 2)
  method    String
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Expense {
  id       String   @id @default(uuid())
  tenantId String
  category String
  note     String?
  party    String?
  amount   Decimal  @db.Decimal(10, 2)
  method   String   @default("CASH")
  date     DateTime @default(now())

  @@index([tenantId, date])
}

model RestTable {
  id       String   @id @default(uuid())
  tenantId String
  name     String
  seats    Int      @default(4)
  status   String   @default("FREE")
  since    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
}

model Kot {
  id        String   @id @default(uuid())
  tenantId  String
  number    Int
  table     String
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  KotItem[]

  @@index([tenantId, status])
}

model KotItem {
  id    String @id @default(uuid())
  kotId String
  name  String
  qty   Int

  kot Kot @relation(fields: [kotId], references: [id], onDelete: Cascade)
}

model Combo {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  ComboItem[]
}

model ComboItem {
  id        String @id @default(uuid())
  comboId   String
  productId String
  qty       Int    @default(1)

  combo   Combo   @relation(fields: [comboId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([comboId])
  @@index([productId])
}

// ─────────────────────────────────────────────
// INGREDIENTS (Raw materials — rice, chicken, oil…)
// ─────────────────────────────────────────────
model Ingredient {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  unit        String // kg / ltr / pcs
  stock       Decimal  @default(0) @db.Decimal(12, 3)
  lowStockAt  Decimal  @default(5) @db.Decimal(12, 3)
  costPerUnit Decimal  @default(0) @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipeItems RecipeItem[]
  wastages    Wastage[]

  @@index([tenantId, name])
}

// ─────────────────────────────────────────────
// RECIPE (1 dish = ? ingredients — BOM)
// ─────────────────────────────────────────────
model RecipeItem {
  id           String  @id @default(uuid())
  productId    String
  ingredientId String
  qty          Decimal @db.Decimal(12, 3) // per 1 plate

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Wastage {
  id           String   @id @default(uuid())
  tenantId     String
  itemType     String // INGREDIENT | PRODUCT
  ingredientId String?
  productId    String?
  qty          Decimal  @db.Decimal(12, 3)
  reason       String // EXPIRED | DAMAGED | SPOILED | OTHER
  note         String?
  date         DateTime @default(now())

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
}
